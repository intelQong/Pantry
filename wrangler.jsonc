{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pantry",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // The SPA is served from ./dist/client. Anything under /api/* and the cron
  // handler run in the Worker; everything else falls through to static assets,
  // with unmatched paths serving index.html so client-side routing works.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pantry-db",
      "database_id": "61c4a9c1-dda5-4e3f-ac6e-19087f0fdd35",
      "migrations_dir": "migrations"
    }
  ],

  // Hourly sweep: decides which member is due a restock digest in their own
  // local timezone, then sends Web Push. See src/worker/cron.ts.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
